# Copy this file to .env.local for local work, and add the same keys in
# Vercel → Project → Settings → Environment Variables for the live site.
# Never put a secret in a NEXT_PUBLIC_ variable: those are visible in the browser.

# ---- Site (public) ----
# The live address. Used for search, social previews and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.gethyre.ai
# Contact emails (default: info@gethyre.in)
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CAREERS_EMAIL=
NEXT_PUBLIC_PRESS_EMAIL=
# Digits only, with country code, e.g. 919876543210. Turns on the WhatsApp button and links.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Social links (default: the official GetHyre.ai Instagram and LinkedIn pages)
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_YOUTUBE_URL=
# App store listings. Until set, the store buttons show but are not clickable.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
# Campus survey (Google Form link)
NEXT_PUBLIC_SURVEY_URL=
# Calendar link for college partnership calls (Cal.com / Calendly)
NEXT_PUBLIC_BOOKING_URL=
# Optional: play the demo video from YouTube/Vimeo/Drive instead of public/video/gethyre-demo-v2.mp4
NEXT_PUBLIC_COLLEGE_VIDEO_URL=

# ---- Leads: Google Sheets (secret) ----
# Sheet tabs needed: Students, Colleges, Companies, Contact. Share the sheet with the service account as Editor.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key on one line with \n for line breaks.
GOOGLE_PRIVATE_KEY=

# ---- Leads: email via Resend (secret) ----
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. GetHyre.ai <info@gethyre.in>
EMAIL_FROM=
# Where college, company and contact-form alerts go
LEADS_ALERT_EMAIL=

# ---- Spam protection: Cloudflare Turnstile ----
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Analytics (public IDs) ----
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=
