# Copy this file to .env.local and fill in what you have.
# The site runs without any of these: forms log to the terminal in development.
# In production, forms need Google Sheets and/or Resend configured, or they show an error.

# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://gethyre.ai
NEXT_PUBLIC_CONTACT_EMAIL=hello@gethyre.ai
NEXT_PUBLIC_CAREERS_EMAIL=careers@gethyre.ai
NEXT_PUBLIC_PRESS_EMAIL=press@gethyre.ai
# Digits only, with country code. Turns on the WhatsApp chat button.
NEXT_PUBLIC_WHATSAPP_NUMBER=91XXXXXXXXXX
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_YOUTUBE_URL=
# Campus survey (Google Form link)
NEXT_PUBLIC_SURVEY_URL=
# Optional Cal.com / Calendly link for college calls
NEXT_PUBLIC_BOOKING_URL=
# Optional YouTube embed link for the demo video, e.g. https://www.youtube.com/embed/VIDEO_ID
NEXT_PUBLIC_DEMO_VIDEO_URL=

# ---- Leads: Google Sheets ----
# Create a sheet with tabs: Students, Colleges, Companies, Ambassadors.
# Share it with the service account email as Editor.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key on one line with \n for line breaks.
GOOGLE_PRIVATE_KEY=

# ---- Leads: email (Resend) ----
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. GetHyre.ai <hello@gethyre.ai>
EMAIL_FROM=
# Where college, company and ambassador alerts go
LEADS_ALERT_EMAIL=

# ---- Spam protection (Cloudflare Turnstile) ----
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Analytics ----
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=
